+	/**
+	 * Get the exact executable definitions for currently active tools, in active order.
+	 * The array is a launch-time snapshot for consumers. Custom, extension, override,
+	 * and MCP definitions retain identity; genuine built-ins are cwd-aware wrappers.
+	 */
+	getActiveToolDefinitions(): readonly ToolDefinition[] {
+		const builtinOptions = {
+			read: { autoResizeImages: this.settingsManager.getImageAutoResize() },
+			bash: {
+				commandPrefix: this.settingsManager.getShellCommandPrefix(),
+				shellPath: this.settingsManager.getShellPath(),
+			},
+		};
+		return this.getActiveToolNames().flatMap((name) => {
+			const entry = this._toolDefinitions.get(name);
+			if (!entry) return [];
+			// Built-ins capture cwd in their execute closures. Return a launch-time
+			// wrapper that rebuilds only genuine built-ins for the execution ctx cwd.
+			// Overrides/custom/MCP definitions preserve their exact executable identity.
+			if (entry.sourceInfo.source === "builtin" && !this._baseToolsOverride && allToolNames.has(name as ToolName)) {
+				const definition = entry.definition;
+				return [{
+					...definition,
+					execute: (toolCallId, params, signal, onUpdate, ctx) => {
+						const rebound = createToolDefinition(name as ToolName, ctx?.cwd ?? this._cwd, builtinOptions);
+						return rebound.execute(toolCallId, params, signal, onUpdate, ctx);
+					},
+				} satisfies ToolDefinition];
+			}
+			return [entry.definition];
+		});
+	}
